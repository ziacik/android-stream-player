#!/bin/sh
set -eu

magnet="${1:-}"
target="${2:-192.168.0.200:5555}"
package="sk.ziacik.androidstreamplayer"
activity="$package/.MainActivity"

device_abi="$(adb -s "$target" shell getprop ro.product.cpu.abi | tr -d '\r')"
case "$device_abi" in
    arm64-v8a|armeabi-v7a)
        ;;
    *)
        echo "Unsupported Android TV ABI: $device_abi" >&2
        exit 3
        ;;
esac

echo "Building for Android TV ABI: $device_abi"
./gradlew assembleDebug -PtorrserverAbi="$device_abi"
adb -s "$target" install -r app/build/outputs/apk/debug/app-debug.apk
adb -s "$target" shell am force-stop "$package"

if [ -n "$magnet" ]; then
    escaped_magnet=$(printf '%s' "$magnet" | sed "s/'/'\\\\''/g")
    adb -s "$target" shell "am start -n '$activity' --es magnet '$escaped_magnet'"
else
    adb -s "$target" shell am start -n "$activity"
fi
